do
    local PendingTrades = {}
    local WorkerRunning = false

    local function CleanID(id)
        return tostring(id):gsub("[{}]", ""):lower()
    end

    SpawnHistoryChecker = function(tradeId, currentItems)
        if not tradeId then return end
        local tid_clean = CleanID(tradeId)
        
        for _, pending in ipairs(PendingTrades) do
            if pending.id == tid_clean then return end
        end

        local snapshot = {}
        for _, item in ipairs(currentItems) do 
            table.insert(snapshot, item)
            ItemsInTransit[item.uid] = true
        end
        table.insert(PendingTrades, { id = tid_clean, items = snapshot, time = tick() })

        if not WorkerRunning then
            WorkerRunning = true
            task.spawn(function()
                while #PendingTrades > 0 do
                    local success, history = pcall(function()
                        return RouterClient.get("TradeAPI/GetTradeHistory"):InvokeServer()
                    end)
                    
                    if success and type(history) == "table" then
                        for i = #PendingTrades, 1, -1 do
                            local pending = PendingTrades[i]
                            local foundTrade = nil
                            for _, pastTrade in ipairs(history) do
                                if CleanID(pastTrade.trade_id) == pending.id then
                                    foundTrade = pastTrade
                                    break
                                end
                            end
                            
                            if foundTrade then
                                local allLootedUids = {}
