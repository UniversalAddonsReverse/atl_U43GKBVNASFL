local function GetTradeState()
    local rawData = ClientData.get_data()[LocalPlayer.Name]
    if not rawData.trade then 
        return "NONE", nil, nil 
    end
    
    local trade = rawData.trade
    local stage = trade.current_stage or "NONE"
    
    local myOffer, theirOffer = nil, nil
    if trade.sender_offer and trade.sender_offer.player_name == LocalPlayer.Name then
        myOffer = trade.sender_offer
        theirOffer = trade.recipient_offer
    elseif trade.recipient_offer and trade.recipient_offer.player_name == LocalPlayer.Name then
        myOffer = trade.recipient_offer
        theirOffer = trade.sender_offer
    end
    
    return stage, myOffer, theirOffer
end

